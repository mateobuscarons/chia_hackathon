# Upstream clones - not our code. ChampSim is a setup step (see the README); the
# chia clone is kept for the block work in CHIA_BLOCKS.md and the loop does not use it.
champsim/
chia/
# Extra ChampSim trees for parallel builds (loop.simulate.tree_paths finds them)
champsim_[0-9]*/
# Compiled ChampSim binaries, one per design: a build cache, rebuilt on demand
champsim_bin/

# Environment, traces and generated inputs
.venv/
traces/
configs/generated/
loop/__pycache__/
# Per-machine cost accounting: the Mac's and the VM's would conflict on every merge
results/llm_usage*.json

# Smoke-gate reports: a gate artifact, not a result
results/runs/smoke_*.json

# Run logs, pids and table locks
results/*.log
results/*.pid
results/**/*.lock

# Result tables fetched from the VM before `loop.workloads merge` folds them in
results_vm*/
# Tables from before the memory rebuild, kept out of the current dataset
results_archive/

# Scratch review notes, kept local rather than in the repo
REVIEW.md
