# Upstream clones - not our code. ChampSim is a setup step (see CLAUDE.md); the chia clone is
# kept for the block work in CHIA_BLOCKS.md and the loop does not use it.
champsim/
chia/
# Extra ChampSim trees for parallel builds (loop.simulate.tree_paths finds them)
champsim_[0-9]*/
# Compiled ChampSim binaries, one per design: a build cache, rebuilt on demand
champsim_bin/
# CACTI 7 clone, built locally for the cache PPA ladders (see CLAUDE.md Setup)
cacti/

# Environment, traces and generated inputs
.venv/
traces/
configs/generated/
loop/__pycache__/
# Per-machine cost accounting
results/llm_usage*.json
# Smoke-gate reports: a gate artifact, not a result
results/runs/smoke_*.json
# Run transcripts, pids and table locks
results/*.log
results/*.pid
results/**/*.lock
