# Upstream clones and setup, not our code: ChampSim (and its spare trees for parallel builds),
# CACTI, the chia clone kept for the upstream patches.
/champsim/
/champsim_[0-9]*/
/cacti/
/chia/
# Compiled ChampSim binaries, one per design: a build cache, rebuilt on demand
/champsim_bin/

# Environment, secrets, traces and generated inputs
.venv/
.env
CLAUDE.local.md
/traces/
/configs/
__pycache__/
.pytest_cache/
competiton.md

# Per-machine and regenerated: the running cost totals, every prompt and answer of a run
results/llm_usage*.json
results/transcripts/
results/**/*.lock
results/runs/*smoke*.json

# The paper's build products other than the PDF
paper/main.log
paper/main.blg
CLAUDE.md
