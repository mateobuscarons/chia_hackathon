# Upstream clones - not our code; see CLAUDE.md setup section
champsim/
chia/
# Extra ChampSim trees for parallel builds (loop.simulate.tree_paths finds them)
champsim_[0-9]*/
# Compiled ChampSim binaries, one per design: a build cache, rebuilt on demand
champsim_bin/

# Environment, traces and generated inputs
.venv/
traces/
configs/generated/
loop/__pycache__/
loop/llm_usage.json
loop/llm_usage.json.lock

# Run logs, locks and regenerated text
results/*.log
results/*.txt
results/*.lock
results/chia_profiles/

# Result tables fetched from the VM before `loop.workloads merge` folds them in
results_vm*/
# Tables from before the memory rebuild, kept out of the current dataset
results_archive/

# Long-form explainers regenerated on demand, not part of the repo
REVIEW.md
memory.md
