# Upstream clones — not our code; see CLAUDE.md setup section
champsim/
chia/
# Extra ChampSim trees for parallel builds (loop.simulate.tree_paths finds them)
champsim_[0-9]*/

# Environment and big/generated files
.venv/
traces/
configs/generated/
loop/__pycache__/
loop/llm_usage.json
loop/playbook.json
results/*.log
results/*.txt
results/chia_profiles/
loop/llm_usage.json.lock
results/*.lock
results/*.flag

# The review pack for outside readers: regenerated on demand, never in the repo
REVIEW.md

# Obsolete outputs (v2/v3 era) and build products: documented in CLAUDE.md, not versioned
results/archive/
champsim_bin/

# Fetched copies of the VM's results, merged into results/ with loop.workloads merge
results_vm*/
